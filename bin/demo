#!/usr/bin/env bash
# Levanta localmente qualquer versão já entregue do Live Quiz, sem tocar na sua
# branch de trabalho nem no banco de desenvolvimento.
#
#   bin/demo <tag>   sobe a aplicação naquela versão em http://localhost:4000
#   bin/demo list    lista as versões disponíveis
#   bin/demo stop    derruba a demonstração em execução
set -euo pipefail

COMPOSE_FILE="docker-compose.demo.yml"
PROJECT_PREFIX="live_quiz_demo"
WORKTREE_DIR=".demo"
# Portas do host; ajuste quando a 4000 ou a 8025 já estiverem ocupadas.
DEMO_PORT="${DEMO_PORT:-4000}"
MAILPIT_UI_PORT="${MAILPIT_UI_PORT:-8025}"

# Por padrão a demonstração é local: os serviços escutam só no loopback e os
# links que ela gera apontam para `localhost`. Para mostrar numa rede — outro
# aparelho lendo o QR code — as duas coisas têm de mudar juntas, porque um bind
# aberto com `PHX_HOST=localhost` produziria um QR que só funciona na máquina
# que o desenhou (R51):
#
#   DEMO_BIND=0.0.0.0 PHX_HOST=192.168.0.10 bin/demo v1.0.0
DEMO_BIND="${DEMO_BIND:-127.0.0.1}"
PHX_HOST="${PHX_HOST:-localhost}"
PHX_SCHEME="${PHX_SCHEME:-http}"
export DEMO_PORT MAILPIT_UI_PORT DEMO_BIND PHX_HOST PHX_SCHEME
APP_URL="${PHX_SCHEME}://${PHX_HOST}:${DEMO_PORT}"
MAIL_URL="http://localhost:${MAILPIT_UI_PORT}"
DEMO_LOGIN="demo@livequiz.dev / demo123456789"
BOOT_TIMEOUT_SECONDS=300

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; RESET=$'\033[0m'

die() { printf '%s✗ %s%s\n' "$RED" "$1" "$RESET" >&2; exit 1; }
info() { printf '%s%s%s\n' "$DIM" "$1" "$RESET"; }

require_tools() {
  # Toda ferramenta que este script chama, e não só as óbvias: descobrir que
  # falta `curl` no meio da espera pelo boot é descobrir tarde (R52).
  for tool in git docker curl; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool não encontrado no PATH."
  done

  docker compose version >/dev/null 2>&1 || die "docker compose (v2) não está disponível."
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "execute o bin/demo de dentro do repositório."
}

# Nome de projeto Compose válido: minúsculas, dígitos, hífen e underscore.
sanitize() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/_/g'
}

phase_of() {
  case "$1" in
    v0.1.0) printf 'Fase 1 — Criação e gerenciamento de quizzes' ;;
    v0.2.0) printf 'Fase 2 — Sala de quiz e lobby em tempo real' ;;
    v0.3.0) printf 'Fase 3 — Execução do quiz em tempo real' ;;
    v1.0.0) printf 'Fase 4 — Pontuação, ranking e histórico' ;;
    *) printf '' ;;
  esac
}

cmd_list() {
  local root; root="$(repo_root)"
  git -C "$root" fetch --tags --quiet 2>/dev/null || info "sem acesso ao remoto; listando apenas as tags locais."

  local tags; tags="$(git -C "$root" tag --list 'v*' --sort=-v:refname)"
  if [ -z "$tags" ]; then
    printf '%sNenhuma versão publicada ainda.%s\n' "$YELLOW" "$RESET"
    printf 'A primeira tag é criada automaticamente no merge da develop na main.\n'
    return 0
  fi

  printf 'Versões disponíveis:\n\n'
  while IFS= read -r tag; do
    local phase; phase="$(phase_of "$tag")"
    if [ -n "$phase" ]; then
      printf '  %-10s %s%s%s\n' "$tag" "$DIM" "$phase" "$RESET"
    else
      printf '  %s\n' "$tag"
    fi
  done <<< "$tags"
  printf '\nPara levantar uma delas: bin/demo <tag>\n'
}

running_projects() {
  docker compose ls --all --format json 2>/dev/null \
    | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
for project in data:
    name = project.get('Name', '')
    if name.startswith('${PROJECT_PREFIX}'):
        print(name, project.get('ConfigFiles', ''))
"
}

cmd_stop() {
  local root; root="$(repo_root)"
  local found=0

  while read -r project config; do
    [ -n "$project" ] || continue
    found=1
    info "derrubando ${project}…"
    local file="${config%%,*}"
    [ -f "$file" ] || file="$root/$COMPOSE_FILE"
    docker compose -f "$file" --project-name "$project" down --remove-orphans >/dev/null
  done < <(running_projects)

  if [ "$found" -eq 0 ]; then
    printf '%sNenhuma demonstração em execução.%s\n' "$YELLOW" "$RESET"
  else
    printf '%s✓ Demonstração encerrada. As portas %s e %s estão livres.%s\n' \
      "$GREEN" "$DEMO_PORT" "$MAILPIT_UI_PORT" "$RESET"
    info "os volumes de banco das demos foram preservados; use 'docker volume ls' para inspecioná-los."
  fi
}

cmd_up() {
  local tag="$1"
  local root; root="$(repo_root)"

  git -C "$root" fetch --tags --quiet 2>/dev/null || info "sem acesso ao remoto; usando as tags locais."

  if ! git -C "$root" rev-parse -q --verify "refs/tags/${tag}" >/dev/null; then
    printf '%s✗ A versão %s não existe.%s\n' "$RED" "$tag" "$RESET" >&2
    printf 'Use "bin/demo list" para ver as versões disponíveis.\n' >&2
    exit 1
  fi

  local slug; slug="$(sanitize "$tag")"
  local project="${PROJECT_PREFIX}_${slug}"
  local worktree="${root}/${WORKTREE_DIR}/${tag}"

  if [ -d "$worktree" ]; then
    verify_worktree "$root" "$worktree" "$tag"
    info "reaproveitando o worktree em ${WORKTREE_DIR}/${tag}"
  else
    info "materializando ${tag} em ${WORKTREE_DIR}/${tag} (sua branch não é alterada)"
    git -C "$root" worktree add --detach --quiet "$worktree" "refs/tags/${tag}"
  fi

  [ -f "${worktree}/${COMPOSE_FILE}" ] || die "a versão ${tag} é anterior ao empacotamento de release e não pode ser demonstrada."

  info "construindo e subindo a imagem de ${tag} (a primeira vez leva alguns minutos)…"
  docker compose --project-directory "$worktree" -f "${worktree}/${COMPOSE_FILE}" \
    --project-name "$project" up --build -d

  wait_for_app "$project" "$worktree" || {
    printf '%s✗ A aplicação não respondeu em %ss.%s\n' "$RED" "$BOOT_TIMEOUT_SECONDS" "$RESET" >&2
    printf 'Logs: docker compose --project-name %s logs app\n' "$project" >&2
    exit 1
  }

  verify_serving "$project" "$worktree" "$tag"

  local phase; phase="$(phase_of "$tag")"
  printf '\n%s✓ Live Quiz %s%s' "$GREEN" "$tag" "$RESET"
  [ -n "$phase" ] && printf ' %s(%s)%s' "$DIM" "$phase" "$RESET"
  printf '\n'
  printf '  Aplicação : %s\n' "$APP_URL"
  printf '  E-mails   : %s\n' "$MAIL_URL"
  printf '  Login demo: %s\n' "$DEMO_LOGIN"
  printf '  Encerrar  : bin/demo stop\n'
}

# Um diretório que existe não é um diretório que continua sendo aquela versão.
# Reaproveitá-lo sem conferir é anunciar uma versão e executar outra, que é
# exatamente o que uma demonstração não pode fazer (R52). Nada é apagado nem
# resetado aqui: o trabalho de quem mexeu no worktree é dele.
verify_worktree() {
  local root="$1" worktree="$2" tag="$3"

  git -C "$worktree" rev-parse --git-dir >/dev/null 2>&1 \
    || die "${WORKTREE_DIR}/${tag} existe mas não é um worktree git. Apague-o e rode de novo."

  local expected actual
  expected="$(git -C "$root" rev-list -n1 "refs/tags/${tag}")"
  actual="$(git -C "$worktree" rev-parse HEAD)"

  if [ "$expected" != "$actual" ]; then
    printf '%s✗ %s/%s está em %s, e a tag %s aponta para %s.%s\n' \
      "$RED" "$WORKTREE_DIR" "$tag" "${actual:0:12}" "$tag" "${expected:0:12}" "$RESET" >&2
    printf 'Apague o diretório e rode de novo: git worktree remove --force %s/%s\n' \
      "$WORKTREE_DIR" "$tag" >&2
    exit 1
  fi

  if [ -n "$(git -C "$worktree" status --porcelain)" ]; then
    printf '%s✗ %s/%s tem alterações locais.%s\n' "$RED" "$WORKTREE_DIR" "$tag" "$RESET" >&2
    printf 'A demonstração anunciaria %s e executaria outra coisa. Reveja ou descarte:\n' "$tag" >&2
    printf '  git -C %s/%s status\n' "$WORKTREE_DIR" "$tag" >&2
    exit 1
  fi
}

wait_for_app() {
  local project="$1" worktree="$2"
  local deadline=$(( SECONDS + BOOT_TIMEOUT_SECONDS ))

  while [ "$SECONDS" -lt "$deadline" ]; do
    if curl -fsS -o /dev/null "$APP_URL" 2>/dev/null; then
      return 0
    fi
    if [ -z "$(docker compose --project-directory "$worktree" -f "${worktree}/${COMPOSE_FILE}" \
                 --project-name "$project" ps --status running --services 2>/dev/null | grep -x app || true)" ]; then
      return 1
    fi
    sleep 2
  done

  return 1
}

# Uma resposta HTTP naquela URL prova que *alguma coisa* atende ali, não que é
# a demonstração desta versão: outro projeto compose, um servidor esquecido de
# ontem, o ambiente de desenvolvimento na mesma porta. O contêiner que responde
# tem de ser o que este script subiu.
verify_serving() {
  local project="$1" worktree="$2" tag="$3"

  local container
  container="$(docker compose --project-directory "$worktree" -f "${worktree}/${COMPOSE_FILE}" \
                 --project-name "$project" ps --quiet app 2>/dev/null | head -n1)"

  [ -n "$container" ] || die "o contêiner da aplicação de ${tag} não está em execução."

  local listening
  listening="$(docker inspect "$container" \
                 --format '{{range $p, $c := .NetworkSettings.Ports}}{{range $c}}{{.HostIp}}:{{.HostPort}} {{end}}{{end}}' \
                 2>/dev/null)"

  case "$listening" in
    *":${DEMO_PORT} "*) : ;;
    *)
      printf '%s✗ Algo responde em %s, mas não é o contêiner desta demonstração.%s\n' \
        "$RED" "$APP_URL" "$RESET" >&2
      printf 'Portas publicadas por ele: %s\n' "${listening:-nenhuma}" >&2
      printf 'Encerre o que estiver na porta e rode de novo, ou use DEMO_PORT=outra.\n' >&2
      exit 1
      ;;
  esac
}

usage() {
  cat <<'USAGE'
Uso:
  bin/demo <tag>   sobe a aplicação naquela versão em http://localhost:4000
  bin/demo list    lista as versões disponíveis
  bin/demo stop    derruba a demonstração em execução

Variáveis:
  DEMO_PORT        porta da aplicação no host (padrão 4000)
  MAILPIT_UI_PORT  porta da caixa de entrada no host (padrão 8025)
  DEMO_BIND        interface em que a aplicação escuta (padrão 127.0.0.1)
  PHX_HOST         host dos links e do QR code (padrão localhost)

Para demonstrar numa rede, as duas últimas mudam juntas — um bind aberto com
PHX_HOST=localhost gera um QR que só funciona na máquina que o desenhou:

  DEMO_BIND=0.0.0.0 PHX_HOST=192.168.0.10 bin/demo v1.0.0
USAGE
}

main() {
  require_tools

  case "${1:-}" in
    ""|-h|--help|help) usage ;;
    list) cmd_list ;;
    stop) cmd_stop ;;
    *) cmd_up "$1" ;;
  esac
}

main "$@"
